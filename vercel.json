{
  "functions": {
    "app/api/flights/route.ts": { "maxDuration": 10 },
    "app/api/earthquakes/route.ts": { "maxDuration": 10 },
    "app/api/satellites/route.ts": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=10, stale-while-revalidate=59" }
      ]
    }
  ]
}
